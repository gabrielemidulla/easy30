{
  "name": "@easy30/core",
  "version": "0.1.0",
  "description": "Easy30 vault format, concept graph and spaced-repetition engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
